# Mobile (Expo) — copy to .env only if auto-detection fails
# Physical phone: use your Mac LAN IP (NOT localhost)
# Find IP: System Settings → Network (e.g. 192.168.1.42)

# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
# EXPO_PUBLIC_WS_URL=ws://192.168.1.42:8000

# iOS Simulator / web only:
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000

# Production example:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com
# EXPO_PUBLIC_WS_URL=wss://api.yourdomain.com
