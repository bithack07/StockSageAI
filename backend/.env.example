# StockSage AI — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Environment ────────────────────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development
DEBUG=false
ENABLE_OPENAPI=true
RATE_LIMIT_ENABLED=true

# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Market Data ──────────────────────────────────────────────────────────────
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
NEWSAPI_KEY=
GNEWS_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stocksage
SQLITE_URL=sqlite+aiosqlite:///./stocksage_local.db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (production: openssl rand -hex 32) ───────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── CORS (comma-separated; no * in production) ───────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,tauri://localhost
